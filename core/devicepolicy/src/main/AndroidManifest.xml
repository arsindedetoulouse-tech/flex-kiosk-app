<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Declared in this library and merged into the application APK.

      `BIND_DEVICE_ADMIN` is a signature-level permission granted by the system, so it needs no
      <uses-permission> entry. `exported="true"` is required: the system binds this receiver from
      outside the application process.
    -->
    <application>
        <receiver
            android:name="com.arsinde.flexkioskapp.core.devicepolicy.admin.KioskDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:exported="true"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
